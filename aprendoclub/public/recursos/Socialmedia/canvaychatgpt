<script>
  function copyPrompt(btn){
    var targetId = btn.getAttribute('data-copy-target');
    var el = document.getElementById(targetId);
    if(!el) return;
    var text = el.innerText;
    function showCopied(){
      var label = btn.querySelector('.copy-btn__text');
      var prev = label.textContent;
      btn.classList.add('copied');
      label.textContent = '¡Copiado!';
      setTimeout(function(){
        btn.classList.remove('copied');
        label.textContent = prev === '¡Copiado!' ? 'Copiar' : prev;
      }, 1800);
    }
    if(navigator.clipboard && navigator.clipboard.writeText){
      navigator.clipboard.writeText(text).then(showCopied, function(){ fallbackCopy(text, showCopied); });
    } else { fallbackCopy(text, showCopied); }
  }
  function fallbackCopy(text, cb){
    try{
      var ta = document.createElement('textarea');
      ta.value = text; ta.style.position='fixed'; ta.style.opacity='0';
      document.body.appendChild(ta); ta.focus(); ta.select();
      document.execCommand('copy'); document.body.removeChild(ta); cb();
    }catch(e){}
  }
  function toggleExpand(btn, wrapId){
    var wrap = document.getElementById(wrapId);
    var label = btn.querySelector('.expand-toggle__text');
    var clamped = wrap.classList.toggle('clamped');
    if(clamped){ label.textContent = 'Mostrar completo'; btn.classList.remove('is-open'); }
    else{ label.textContent = 'Contraer'; btn.classList.add('is-open'); }
  }

  /* Gate: envío real al endpoint extraído + desbloqueo en la misma página */
  (function(){
    var form = document.getElementById('gate-form');
    var GATE_ENDPOINT = form.getAttribute('action');
    var gate = document.getElementById('gate');
    var errorMsg = document.getElementById('gate-error');
    var unlocked = false;

    function unlockPage(){
      if(unlocked) return;
      unlocked = true;
      gate.classList.add('is-hidden');
      document.body.classList.remove('locked');
      setTimeout(function(){ gate.style.display = 'none'; }, 400);
    }

    form.addEventListener('submit', function(e){
      e.preventDefault();
      var btn = form.querySelector('.gate-submit');
      var original = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Enviando...';

      var data = new FormData(form);
      var failSafe = setTimeout(function(){ unlockPage(); }, 2500);

      fetch(GATE_ENDPOINT, { method: 'POST', mode: 'no-cors', body: data })
        .catch(function(){ errorMsg.classList.add('show'); })
        .finally(function(){
          clearTimeout(failSafe);
          btn.textContent = original;
          btn.disabled = false;
          unlockPage();
        });
    });
  })();
</script>

