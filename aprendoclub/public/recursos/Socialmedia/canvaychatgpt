<style>
  /* ===== Sistema de diseño SEO Lab — NO cambiar salvo pedido explícito ===== */
  :root{
    box-sizing:border-box;
    padding-top:env(safe-area-inset-top,0px);
    padding-bottom:env(safe-area-inset-bottom,0px);

    --bg:#17181B;
    --bg-soft:#1B1C20;
    --card:#1E2023;
    --card-raised:#232529;
    --ink:#F5F5F3;
    --ink-soft:#9C9FA5;
    --ink-mute:#6D7076;
    --lime:#D7FF4B;
    --lime-dim:#A9CC3C;
    --lime-ink:#14150E;
    --lime-tint:rgba(215,255,75,.10);
    --lime-glow:rgba(215,255,75,.28);
    --border:rgba(255,255,255,.08);
    --border-soft:rgba(255,255,255,.06);
    --code-bg:#101113;
    --code-ink:#D9DBDD;
    --shadow:rgba(0,0,0,.45);
  }
  html{scroll-behavior:smooth; scroll-padding-top:76px;}
  *{box-sizing:border-box;}
  body{
    margin:0; background:var(--bg); color:var(--ink);
    font-family:'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    line-height:1.65; -webkit-font-smoothing:antialiased;
  }
  body.locked{overflow:hidden;}
  a{color:inherit;}
  h1,h2,h3{font-family:'Plus Jakarta Sans', sans-serif; font-weight:800; line-height:1.12; letter-spacing:-.01em; margin:0 0 .5em; color:var(--ink);}
  p{margin:0 0 1em;}
  .accent{color:var(--lime);}
  .wrap{max-width:820px; margin:0 auto; padding:0 24px;}
  .eyebrow{display:block; font-size:12.5px; font-weight:700; color:var(--lime); letter-spacing:.14em; text-transform:uppercase; margin-bottom:16px;}
  .badge-pill{display:inline-flex; align-items:center; background:var(--lime); color:var(--lime-ink); font-weight:800; font-size:12px; letter-spacing:.08em; text-transform:uppercase; padding:8px 16px; border-radius:999px; margin-bottom:20px;}
  .center{text-align:center;}
  .center .wrap{display:flex; flex-direction:column; align-items:center;}

  section{padding:72px 0;}
  section.tight{padding:56px 0;}
  section + section{border-top:1px solid var(--border-soft);}

  .hero{padding:96px 0 72px;}
  .hero h1{font-size:44px; max-width:16ch; margin:0 auto .4em;}
  .hero .lede{font-size:18px; color:var(--ink-soft); max-width:52ch; margin:0 auto 10px;}
  .hero .note{font-size:14.5px; color:var(--ink-mute); max-width:44ch; margin:0 auto 0;}

  .grid{display:grid; gap:16px;}
  .grid-3{grid-template-columns:repeat(3,1fr);}
  .grid-4{grid-template-columns:repeat(4,1fr);}
  .n-card{background:var(--card); border:1px solid var(--border); border-radius:16px; padding:24px 22px; text-decoration:none; display:block; transition:border-color .15s ease, transform .15s ease;}
  a.n-card:hover{border-color:var(--lime-glow); transform:translateY(-2px);}
  .n-card__num{font-family:'IBM Plex Mono', monospace; font-weight:600; font-size:14px; color:var(--lime); display:block; margin-bottom:12px;}
  .n-card h3{font-size:17px; font-weight:700; margin:0 0 8px; color:var(--ink);}
  .n-card p{font-size:14px; color:var(--ink-soft); margin:0;}
  .n-card__go{margin-top:14px; display:inline-flex; align-items:center; gap:6px; font-size:13px; font-weight:600; color:var(--lime);}

  h2.h-section{font-size:32px; max-width:18ch;}

  .skill-head{display:flex; align-items:baseline; gap:14px; margin-bottom:18px;}
  .skill-icon{font-size:28px; line-height:1;}
  .skill h2{font-size:27px; margin:0;}

  .framing{background:var(--card); border:1px solid var(--border); border-left:3px solid var(--lime); border-radius:4px 14px 14px 4px; padding:20px 22px; margin:22px 0; font-size:16.5px; color:var(--ink-soft);}
  .framing strong{color:var(--lime); font-weight:700;}

  .subhead{font-size:12.5px; font-weight:700; text-transform:uppercase; letter-spacing:.12em; color:var(--lime); margin:30px 0 14px;}
  ul.checklist{list-style:none; margin:0 0 8px; padding:0; display:grid; gap:11px;}
  ul.checklist li{display:flex; gap:10px; font-size:15px; color:var(--ink-soft);}
  ul.checklist li::before{content:"✓"; color:var(--lime); font-weight:700; flex:none;}

  .prompt-box{margin-top:24px; border-radius:16px; overflow:hidden; background:var(--code-bg); border:1px solid var(--border); box-shadow:0 10px 30px var(--shadow);}
  .prompt-box__head{display:flex; align-items:center; justify-content:space-between; padding:14px 18px; border-bottom:1px solid var(--border-soft);}
  .prompt-box__label{font-family:'IBM Plex Mono', monospace; font-size:12.5px; color:var(--lime); letter-spacing:.06em;}
  .copy-btn{display:inline-flex; align-items:center; gap:7px; background:transparent; border:1px solid var(--border); color:var(--code-ink); font-family:'Plus Jakarta Sans',sans-serif; font-size:13px; font-weight:600; padding:8px 14px; border-radius:999px; cursor:pointer; transition:background .15s ease, border-color .15s ease, color .15s ease;}
  .copy-btn:hover{background:var(--lime-tint); border-color:var(--lime-glow); color:var(--lime);}
  .copy-btn:focus-visible{outline:2px solid var(--lime); outline-offset:2px;}
  .copy-btn.copied{border-color:var(--lime); color:var(--lime); background:var(--lime-tint);}
  .copy-btn svg{width:14px;height:14px;flex:none;}
  .prompt-box__body{position:relative; max-height:1600px; overflow:hidden; transition:max-height .35s ease;}
  .prompt-box__body.clamped{max-height:300px;}
  .prompt-box__body.clamped::after{content:""; position:absolute; left:0; right:0; bottom:0; height:90px; background:linear-gradient(to bottom, transparent, var(--code-bg)); pointer-events:none;}
  .prompt-box pre{margin:0; padding:20px 22px 26px; font-family:'IBM Plex Mono', monospace; font-size:12.8px; line-height:1.7; color:var(--code-ink); white-space:pre-wrap; word-break:break-word;}
  .expand-toggle{display:flex; align-items:center; gap:6px; width:100%; background:var(--bg-soft); color:var(--ink-soft); border:none; border-top:1px solid var(--border-soft); font-family:'Plus Jakarta Sans',sans-serif; font-size:13px; font-weight:600; padding:12px; cursor:pointer; justify-content:center;}
  .expand-toggle:hover{color:var(--lime);}
  .expand-toggle svg{width:13px;height:13px; transition:transform .25s ease;}
  .expand-toggle.is-open svg{transform:rotate(180deg);}

  .back-to-index{display:inline-block; margin-top:30px; font-size:14px; color:var(--lime); text-decoration:none; font-weight:600;}
  .back-to-index:hover{color:var(--lime-dim);}

  .tip{display:flex; gap:12px; align-items:flex-start; background:var(--card); border:1px solid var(--border); border-radius:14px; padding:18px 20px; font-size:14px; margin-top:20px;}
  .tip p{margin:0; color:var(--ink-soft);}
  .tip strong{color:var(--lime);}

  .cta-band h2{font-size:32px; max-width:18ch;}
  .cta-band > .wrap > p{color:var(--ink-soft); max-width:56ch;}
  .cta-panel{display:grid; grid-template-columns:1.3fr 1fr; gap:40px; background:var(--card); border:1px solid var(--lime-glow); border-radius:26px; padding:40px; margin-top:32px; box-shadow:0 0 60px var(--lime-tint);}
  .cta-panel h3{font-size:20px; margin-bottom:16px;}
  .cta-check{width:42px;height:42px;border-radius:50%; background:var(--lime-tint); color:var(--lime); display:flex; align-items:center; justify-content:center; font-weight:700; font-size:18px; margin-bottom:16px;}
  .cta-right h3{font-size:19px; margin-bottom:8px;}
  .cta-right p{color:var(--ink-soft); font-size:14.5px; margin-bottom:22px;}
  .cta-btn{display:inline-flex; align-items:center; justify-content:center; gap:8px; width:100%; background:var(--lime); color:var(--lime-ink); font-weight:700; font-size:15.5px; padding:16px 22px; border-radius:999px; text-decoration:none; transition:background .15s ease, transform .15s ease;}
  .cta-btn:hover{background:#E4FF7A; transform:translateY(-1px);}
  .cta-btn:focus-visible{outline:2px solid var(--lime); outline-offset:3px;}
  .cta-url{display:block; text-align:center; margin-top:12px; font-family:'IBM Plex Mono', monospace; font-size:12px; color:var(--ink-mute);}

  footer{padding:36px 0 52px; text-align:center; font-size:13px; color:var(--ink-mute);}

  /* ===== Gate (bloqueo por correo) ===== */
  .gate{position:fixed; inset:0; z-index:999; display:flex; align-items:center; justify-content:center; padding:24px; background:rgba(10,11,10,.74); backdrop-filter:blur(16px) saturate(120%); -webkit-backdrop-filter:blur(16px) saturate(120%); opacity:1; transition:opacity .35s ease;}
  .gate.is-hidden{opacity:0; pointer-events:none;}
  .gate-card{width:100%; max-width:440px; background:#FFFFFF; color:#14151A; border-radius:28px; padding:40px 36px; box-shadow:0 40px 100px rgba(0,0,0,.55);}
  .gate-card h2{color:#14151A; font-size:25px; max-width:none; margin-bottom:14px;}
  .gate-card p.gate-desc{color:#5B5F66; font-size:15px; line-height:1.55; margin-bottom:26px;}
  .gate-field{margin-bottom:18px;}
  .gate-field label{display:block; font-weight:700; font-size:13.5px; margin-bottom:8px; color:#14151A;}
  .gate-field input{width:100%; padding:14px 16px; border-radius:12px; border:1px solid #E2E1DA; background:#fff; color:#14151A; font-size:15px; font-family:inherit;}
  .gate-field input::placeholder{color:#A9ACB1;}
  .gate-field input:focus{outline:2px solid var(--lime); outline-offset:1px; border-color:transparent;}
  .gate-submit{width:100%; background:#14151A; color:var(--lime); font-weight:800; font-size:16px; padding:16px; margin-top:6px; border:none; border-radius:14px; cursor:pointer; transition:background .15s ease, opacity .15s ease;}
  .gate-submit:hover{background:#0B0C0F;}
  .gate-submit[disabled]{opacity:.65; cursor:progress;}
  .gate-disclaimer{text-align:center; font-size:13px; color:#8B8E93; margin:18px 0 0;}
  .gate-error{display:none; color:#B3261E; font-size:13px; margin:-8px 0 16px; font-weight:600;}
  .gate-error.show{display:block;}

  @media (max-width:760px){.cta-panel{grid-template-columns:1fr;}}
  @media (max-width:640px){
    .hero h1{font-size:32px;} h2.h-section{font-size:26px;}
    .grid-3{grid-template-columns:1fr;} .grid-4{grid-template-columns:1fr 1fr;}
    .cta-panel{padding:26px;} .gate-card{padding:32px 26px; border-radius:22px;}
  }
</style>
</head>
