<script>
/* ---- Desbloqueo del prompt tras rellenar el formulario ---- */
(function () {
  var LLAVE = 'aprendoclub_acceso_prompt_auditoria';
  var zona = document.getElementById('seccion-acceso');
  var contenido = document.getElementById('seccion-prompt');
  var barra = document.getElementById('barra-fija');
  var formulario = document.getElementById('form-acceso');
  var error = document.getElementById('error-form');
  var abierto = false;

  function recordar() { try { localStorage.setItem(LLAVE, '1'); } catch (e) {} }
  function yaEntro() { try { return localStorage.getItem(LLAVE) === '1'; } catch (e) { return false; } }

  function desbloquear(irAlContenido) {
    if (abierto) return;
    abierto = true;
    recordar();
    zona.hidden = true;
    contenido.hidden = false;
    if (barra) barra.hidden = true;
    if (irAlContenido) contenido.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  // Ya rellenó el formulario antes, o llega con ?acceso=ok
  if (yaEntro() || new URLSearchParams(location.search).get('acceso') === 'ok') {
    desbloquear(false);
    return;
  }

  if (!formulario) return;

  formulario.addEventListener('submit', function (e) {
    var nombre = document.getElementById('campo-nombre').value.trim();
    var correo = document.getElementById('campo-correo').value.trim();
    var correoValido = /^[^@\s]+@[^@\s]+\.[^@\s]{2,}$/.test(correo);

    // Sin datos válidos no se envía ni se desbloquea
    if (!nombre || !correoValido) {
      e.preventDefault();
      error.hidden = false;
      (nombre ? document.getElementById('campo-correo') : document.getElementById('campo-nombre')).focus();
      return;
    }

    // El POST viaja al iframe oculto, así que la página no se recarga
    error.hidden = true;
    var boton = formulario.querySelector('button');
    boton.disabled = true;
    boton.textContent = 'Un momento…';
    setTimeout(function () { desbloquear(true); }, 900);
  });
})();
</script>

<script>
  document.getElementById('copiar').addEventListener('click', async function () {
    const texto = document.getElementById('texto-prompt').innerText.trim();
    const boton = this;
    try {
      await navigator.clipboard.writeText(texto);
    } catch (e) {
      const area = document.createElement('textarea');
      area.value = texto;
      document.body.appendChild(area);
      area.select();
      document.execCommand('copy');
      area.remove();
    }
    boton.textContent = 'Prompt copiado ✓';
    boton.classList.add('listo');
    setTimeout(function () {
      boton.textContent = 'Copiar prompt';
      boton.classList.remove('listo');
    }, 2500);
  });
</script>

